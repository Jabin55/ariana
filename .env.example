ANTHROPIC_API_KEY=sk-ant-...
# 선택: 모델과 effort(low/medium/high) 변경
# CHATBOT_MODEL=claude-opus-5-5
# CHATBOT_EFFORT=low

# ── 실시간 수업 (/live) ──
# 구글 로그인 (Google Cloud 콘솔 → OAuth 클라이언트 ID)
GOOGLE_CLIENT_ID=1234567890-xxxx.apps.googleusercontent.com
# 학생이 쓸 수 있는 학교 구글 계정 도메인 (쉼표로 여러 개)
ALLOWED_DOMAINS=s.school.kr
# 선생님 계정 (쉼표로 여러 개, 어떤 도메인이든 가능)
TEACHER_EMAILS=teacher@school.kr
# 학생이 고를 학교 목록 (비우면 직접 입력)
SCHOOLS=가나중학교,다라고등학교
# 로그인 쿠키 서명 키 (아무 긴 무작위 문자열)
SECRET_KEY=change-me-to-a-long-random-string
# 데이터베이스 (Neon 무료 PostgreSQL 주소). 비우면 로컬 live.db 파일
DATABASE_URL=postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# 화상 서버
LIVEKIT_URL=wss://내프로젝트.livekit.cloud
LIVEKIT_API_KEY=API...
LIVEKIT_API_SECRET=...
